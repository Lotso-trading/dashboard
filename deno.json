{
    "name": "@lotso-trading/dashboard",
    "version": "1.0.0",
    "exports": "./src/main.ts",
    "imports": {
        "@lotso-trading/shared": "npm:@lotso-trading/shared@1.0.0-develop.4",
        "vue": "npm:vue@^3.5.45",
        "pinia": "npm:pinia@^4.1.0",
        "lucide-vue-next": "npm:lucide-vue-next@^1.0.0",
        "@vitejs/plugin-vue": "npm:@vitejs/plugin-vue@^6.0.11",
        "vite": "npm:vite@^8.3.8"
    },
    "compilerOptions": {
        "lib": [
            "dom",
            "dom.iterable",
            "esnext"
        ],
        "strict": true,
        "noImplicitAny": true,
        "strictNullChecks": true,
        "noUncheckedIndexedAccess": true
    },
    "tasks": {
        "dev": "deno run -A --node-modules-dir npm:vite",
        "build": "deno run -A --node-modules-dir npm:vite build",
        "preview": "deno run -A --node-modules-dir npm:vite preview",
        "lint": "deno run -A npm:@biomejs/biome check .",
        "format": "deno run -A npm:@biomejs/biome format --write .",
        "check": "deno check src/main.ts",
        "test": "deno test -A tests/"
    }
}
