{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "baseUrl": ".",
    "paths": {
      "@polymarket-copy/shared": ["../../packages/shared/src/index.ts"],
      "@polymarket-copy/shared/*": ["../../packages/shared/src/*"]
    },
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*", "src/**/*.vue"]
}
