{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "noImplicitAny": true,
        "strictNullChecks": true,
        "noUncheckedIndexedAccess": true,
        "jsx": "preserve",
        "jsxImportSource": "vue",
        "baseUrl": ".",
        "paths": {
            "@lotso-trading/shared": [
                "../../node_modules/@lotso-trading/shared",
                "../../packages/shared/src/index.ts"
            ],
            "@lotso-trading/shared/*": [
                "../../node_modules/@lotso-trading/shared/*",
                "../../packages/shared/src/*"
            ]
        },
        "allowImportingTsExtensions": true
    },
    "include": ["src/**/*", "src/**/*.vue"]
}
